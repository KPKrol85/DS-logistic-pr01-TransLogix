{
  "name": "translogix",
  "version": "1.0.0",
  "private": true,
  "description": "TransLogix – B2B transport & logistics website (HTML, CSS, JS)",
  "author": "KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write index.html assets/css/modules/pages.css assets/js/accordion-faq.js",
    "format:check": "prettier --check index.html assets/css/modules/pages.css assets/js/accordion-faq.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build",
    "preview": "vite preview",
    "assets:verify": "node scripts/verify-assets.js",
    "assets:optimize": "node scripts/optimize-images.js",
    "assets:fleet": "node scripts/generate-fleet-images.js",
    "qa:html": "node scripts/validate-source-html.js",
    "qa:jsonld": "node scripts/validate-jsonld.js",
    "qa:links": "node scripts/check-local-links.js",
    "qa:a11y": "start-server-and-test \"http-server . -p 8080\" http://127.0.0.1:8080 \"pa11y-ci --config .pa11yci.json\"",
    "qa:budget": "npm run build && node scripts/check-budgets.js",
    "qa:package": "npm run build && node scripts/check-package.js",
    "qa:lighthouse": "npm run build && npx --yes @lhci/cli@0.14.0 autorun --config=./lighthouserc.json",
    "qa": "npm run qa:html && npm run qa:jsonld && npm run qa:links && npm run qa:a11y",
    "release-check": "npm run qa && npm run assets:verify && npm run qa:budget && npm run qa:package && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e": "npm run qa:links"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.9",
    "html-validate": "^9.7.1",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.3",
    "start-server-and-test": "^2.1.5",
    "vite": "^8.2.1"
  }
}
